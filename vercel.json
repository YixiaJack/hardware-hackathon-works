{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "echo 'static site: data is built by GitHub Actions'",
  "outputDirectory": "site",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(data.json|feed.xml|app.js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
